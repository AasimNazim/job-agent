# Environment Configuration for Job Agent

# [DASHBOARD / BACKEND API]
# Secret token for authenticating to the Dashboard API. Change this in production!
DASHBOARD_API_TOKEN=change-me

# Database connection URL (supports SQLite for local dev & PostgreSQL/Supabase for production)
# Local SQLite: sqlite:///job_agent.db
# Supabase PostgreSQL (Session/Transaction Pooler): postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# Supabase PostgreSQL (Direct): postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres
DATABASE_URL=sqlite:///job_agent.db
DASHBOARD_DATABASE_URL=sqlite:///job_agent.db

# Allowed CORS origins for the frontend to talk to the backend
DASHBOARD_CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:80

# [PUBLIC DEMO / RECRUITER MODE]
# Enable unauthenticated public read access for recruiters (Overview, Jobs, Companies, Analytics)
DEMO_MODE=true

# Exclude/strip sensitive emails, API keys, phone numbers, and system metadata from public API responses
DEMO_MASK_SENSITIVE_DATA=true

# [AUTONOMOUS AGENT / AI]
# Gemini API Key for parsing resumes and generating application emails
GEMINI_API_KEY=your-gemini-key-here

# Optional: Proxy URL for scraping jobs to avoid rate limits
# PROXY_URL=http://proxy-server:8080

# Gmail integration token for pushing drafts (usually populated automatically by OAuth script)
# GMAIL_TOKEN_JSON=
